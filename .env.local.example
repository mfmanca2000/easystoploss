#MongoDB Atlas — free M0 cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/easystoploss?retryWrites=true&w=majority

# Resend — free at https://resend.com (3000 emails/month)
RESEND_API_KEY=re_your_key_here
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_TO_EMAIL=you@example.com

# Cron secret — Vercel auto-generates this; set the same value in Vercel env vars
CRON_SECRET=your_random_secret_here

# Pushover — optional mobile push notifications (https://pushover.net)
# Create an application at https://pushover.net/apps/build to get APP_TOKEN
# Your user key is on your Pushover dashboard
PUSHOVER_APP_TOKEN=your_app_token_here
PUSHOVER_USER_KEY=your_user_key_here
